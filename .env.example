# All ports live here. Everything else derives from them.

# Local `turso dev` server
TURSO_PORT=8080
# Hono API
API_PORT=3000
# Vite dev server
WEB_PORT=5173

# Derived from TURSO_PORT. A hosted deployment swaps this for libsql:// + a token.
# (E2E ignores this file entirely - see playwright.config.ts.)
TURSO_DATABASE_URL=http://127.0.0.1:${TURSO_PORT}
# TURSO_AUTH_TOKEN=
